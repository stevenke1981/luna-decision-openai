# Copy to .env.local (ignored by git) and fill in. Variables already set in the system
# environment win over this file. luna-decision-openai also reads ~/.luna-decision-openai/.env.local.

# Billed for every Luna decision (OpenAI Decisions API, gpt-6-luna). Optional: with the default
# LUNA_MODE=auto, Luna decides when this key is set and the built-in rules decide when it is not.
OPENAI_API_KEY=sk-...

# Optional: the main model through OpenRouter (install --provider openrouter).
# Luna still needs OPENAI_API_KEY: OpenRouter keys cannot call the Decisions API.
# OPENROUTER_API_KEY=sk-or-...

# Optional: a separate key just for Luna (wins over OPENAI_API_KEY).
# LUNA_API_KEY=sk-...

# Optional settings
# LUNA_MODEL=gpt-6.1-terra          # gpt-6.1-terra | gpt-6.1-sol | gpt-6-astra
# LUNA_DEFAULT_EFFORT=medium
# LUNA_LEVELS=low,medium,high,xhigh,max
# LUNA_PROVIDER=chatgpt             # chatgpt | openai | openrouter
# LUNA_MODE=auto                    # auto | luna | heuristic | llm | off
# LUNA_AUTO_FALLBACK=heuristic      # what auto uses without a key: heuristic | llm
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# LUNA_MAX_CONTINUES=20             # resumes per turn in all (self-review rounds included)
# LUNA_MAX_STALLS=2                 # extra resumes without progress before letting go (0 = only after progress)
# LUNA_VERIFY=on                    # changed code must be checked (tests/build) before the turn ends
# LUNA_REVIEW_ROUNDS=1              # self-review rounds per turn with changed code; 0 = off
